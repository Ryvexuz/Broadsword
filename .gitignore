# Working areas: the folders are tracked, what's inside them is not.
# Cleanup jobs must leave each .gitkeep in place.
/scratch/*
!/scratch/.gitkeep
/build/*
!/build/.gitkeep
# Cargo refuses `cargo clean -p` on a target folder without this tag; build/ existed before cargo did, so it is tracked
!/build/CACHEDIR.TAG
/shared/*
!/shared/.gitkeep

# Durable job records for recovery
/state/

# Workload projects, each its own Git repo
/projects/

# One Git worktree per task (broadsword worktree ...)
/worktrees/

# Pause flag written by the resource monitor
/broadsword.paused

# Secrets
.env

# Per-machine Claude Code settings
.claude/settings.local.json

# OS noise
Thumbs.db
.DS_Store

# Python bytecode
__pycache__/
*.pyc
